{
  "ecc-pre-tool": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/antigravity-hook-dispatcher.js PreToolUse",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/antigravity-hook-dispatcher.js PreToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "ecc-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node scripts/hooks/antigravity-hook-dispatcher.js SessionStart",
        "timeout": 10
      }
    ]
  },
  "ecc-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/hooks/antigravity-hook-dispatcher.js Stop",
        "timeout": 10
      }
    ]
  }
}
